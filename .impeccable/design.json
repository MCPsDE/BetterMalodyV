      "html": "<label class=\"ds-path\">游戏目录<input aria-label=\"Malody V 游戏目录\" value=\"C:\\SteamLibrary\\steamapps\\common\\MalodyV\"></label>",
      "css": ".ds-path{display:grid;gap:12px;color:#242424;font:700 11pt 'Microsoft YaHei UI','Segoe UI Variable Text','Segoe UI',sans-serif}.ds-path input{font:10pt 'Microsoft YaHei UI','Segoe UI Variable Text','Segoe UI',sans-serif;background:#FFFFFF;color:#242424;border:1px solid #E1E1E1;padding:3px 4px;min-width:0}.ds-path input:focus-visible{outline:1px solid #0F6CBD;outline-offset:0}.ds-path input:disabled{color:#616161;background:#FAFAFA}"
